          "http": {
            "method": "GET",
            "url": "https://api.mainnet.tensordev.io/api/v1/user/pools/tamm",
            "params": [
              {
                "name": "wallet",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "User TAmm Pools"
        },
        {
          "info": {
            "name": "User Transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mainnet.tensordev.io/api/v1/user/transactions",
            "params": [
              {
                "name": "wallet",
                "value": "",
                "type": "query"
              }
            ]
          },
